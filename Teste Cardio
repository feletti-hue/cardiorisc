<!DOCTYPE html>
<html lang="pt-BR" data-theme="">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>CardioRisco – Calculadoras de risco cardiovascular e diabetes</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:wght@500;700&family=Public+Sans:wght@400;600&display=swap">
<style>
:root{--bg:#edf2f5;--card:#fff;--tx:#10243a;--mut:#5a6b7d;--ac:#0b6f84;--bd:#d5dee5;--ok:#1b8a57;--mid:#b97a05;--hi:#c0262d;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0e171f;--card:#16232e;--tx:#e8eef3;--mut:#93a5b5;--ac:#4fc1d6;--bd:#27394a;--ok:#4cc38a;--mid:#e2ad3f;--hi:#f0757b}}
:root[data-theme="dark"]{--bg:#0e171f;--card:#16232e;--tx:#e8eef3;--mut:#93a5b5;--ac:#4fc1d6;--bd:#27394a;--ok:#4cc38a;--mid:#e2ad3f;--hi:#f0757b}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 'Public Sans',system-ui,sans-serif}
main{max-width:720px;margin:0 auto;padding:20px 16px 40px}
h1,h2,.big{font-family:'Newsreader',Georgia,serif}
h1{font-size:2rem;line-height:1.1;margin:8px 0 6px}
.sub{color:var(--mut);margin:0 0 18px;max-width:60ch}
nav{display:flex;gap:8px;overflow-x:auto;padding-bottom:6px;margin-bottom:14px}
nav button{flex:none;border:1px solid var(--bd);background:var(--card);color:var(--tx);border-radius:999px;padding:8px 14px;font:inherit;font-size:.9rem;cursor:pointer}
nav button.on{background:var(--ac);border-color:var(--ac);color:var(--bg);font-weight:600}
nav[hidden]{display:none}
#G{margin-bottom:8px}
#G button{font-weight:600}
#T button{font-size:.82rem;padding:6px 12px;background:transparent;color:var(--mut)}
#T button.on{background:var(--card);border-color:var(--ac);color:var(--ac);font-weight:600}
button:focus-visible,input:focus-visible,select:focus-visible{outline:3px solid var(--ac);outline-offset:2px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:14px;padding:18px}
h2{font-size:1.4rem;margin:0 0 4px}
.d{color:var(--mut);margin:0 0 14px;font-size:.92rem}
.g{display:grid;gap:12px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
label{display:flex;flex-direction:column;gap:4px;font-size:.88rem;font-weight:600}
input[type=number],select{font:inherit;font-weight:400;padding:10px;border:1px solid var(--bd);border-radius:8px;background:var(--bg);color:var(--tx);width:100%}
label.ck{flex-direction:row;align-items:center;gap:10px;font-weight:400;padding:8px 0}
label.ck input{width:20px;height:20px;accent-color:var(--ac)}
.res{margin-top:16px;border-top:3px solid var(--bd);padding-top:14px}
.res.l0{border-color:var(--ok)}.res.l1{border-color:var(--mid)}.res.l2{border-color:var(--hi)}
.big{font-size:2.8rem;font-weight:700;line-height:1}
.res.l0 .big{color:var(--ok)}.res.l1 .big{color:var(--mid)}.res.l2 .big{color:var(--hi)}
.lab{font-weight:600;margin:4px 0 12px}
.bar{display:grid;grid-template-columns:repeat(3,1fr);gap:4px}
.bar span{font-size:.76rem;color:var(--mut)}
.bar i{display:block;height:9px;border-radius:5px;background:var(--bd);margin-bottom:5px}
.bar .a{color:var(--tx);font-weight:600}
.l0 .bar .a i{background:var(--ok)}.l1 .bar .a i{background:var(--mid)}.l2 .bar .a i{background:var(--hi)}
.res p{font-size:.9rem;margin:12px 0 0}
.w{color:var(--mid)}.e{color:var(--mut)}
footer{margin-top:22px;font-size:.8rem;color:var(--mut)}
footer p{margin:0 0 8px}
</style>
</head>
<body>
<main>
<h1>CardioRisco</h1>
<p class="sub">Escalas de risco cardiovascular e de diabetes para estudo e raciocínio clínico. Preencha os campos e o resultado aparece na hora.</p>
<nav id="G" aria-label="Temas"></nav>
<nav id="T" aria-label="Calculadoras do tema"></nav>
<section class="card"><div id="F"></div><div id="R" aria-live="polite"></div></section>
<footer>
<p><b>Uso educacional.</b> As ferramentas apoiam o estudo e não substituem o julgamento clínico nem as diretrizes vigentes. Nenhum dado digitado sai do seu aparelho.</p>
<p>Referências: D'Agostino et al., Circulation 2008 (Framingham); Diretriz Brasileira de Hipertensão Arterial 2020; Lindström e Tuomilehto, Diabetes Care 2003 (FINDRISC); ESC 2020 (fibrilação atrial); Reddy et al., Circulation 2018 (H2FPEF); Pisters et al., Chest 2010 (HAS-BLED); NCEP ATP III 2001 e I Diretriz Brasileira de Síndrome Metabólica; McKee et al., NEJM 1971 (Framingham, IC); Antman et al., JAMA 2000 (TIMI); Wells et al., Thromb Haemost 2000 (TEP).</p>
</footer>
</main>
<script>
const n=(id,l,min,max,u)=>({id,l,k:'n',min,max,u:u?' '+u:''});
const s=(id,l,o)=>({id,l,k:'s',o});
const c=(id,l)=>({id,l,k:'c'});
const f1=x=>x.toLocaleString('pt-BR',{maximumFractionDigits:1});
const SEX=[['M','Masculino'],['F','Feminino']];
const C=[
{t:'Risco CV global',h:'Framingham: risco cardiovascular em 10 anos',d:'Probabilidade de evento cardiovascular (DAC, AVC, DAP ou IC) em 10 anos, versão com perfil lipídico (2008).',
z:['Baixo (&lt; 5%)','Intermediário','Alto'],
f:[n('age','Idade',30,74,'anos'),s('sex','Sexo',SEX),n('tc','Colesterol total',100,400,'mg/dL'),n('hdl','HDL-colesterol',20,100,'mg/dL'),n('sbp','Pressão sistólica',90,200,'mmHg'),c('trt','Em uso de anti-hipertensivo'),c('smk','Tabagista'),c('dm','Diabetes')],
r(v){const m=v.sex=='M',L=Math.log;
const t=m?3.06117*L(v.age)+1.1237*L(v.tc)-0.93263*L(v.hdl)+(v.trt?1.99881:1.93303)*L(v.sbp)+0.65451*v.smk+0.57367*v.dm-23.9802
:2.32888*L(v.age)+1.20904*L(v.tc)-0.70833*L(v.hdl)+(v.trt?2.82263:2.76157)*L(v.sbp)+0.52873*v.smk+0.69154*v.dm-26.1931;
const p=100*(1-Math.pow(m?0.88936:0.95012,Math.exp(t))),lim=m?20:10;
const lv=p<5?0:p<=lim?1:2;
return{big:f1(p)+'%',lab:['Risco baixo','Risco intermediário','Risco alto'][lv],lv,
note:`Pontos de corte (diretrizes brasileiras): baixo &lt; 5%, intermediário 5–${lim}%, alto &gt; ${lim}% para ${m?'homens':'mulheres'}. Fatores agravantes (história familiar precoce, síndrome metabólica, DRC, escore de cálcio) podem reclassificar o paciente.`}}},
{t:'Pressão arterial',h:'Classificação da pressão arterial (HAS)',d:'Classificação da medida casual de consultório, adultos acima de 18 anos.',
z:['Ótima ou normal','Pré-hipertensão','Hipertensão'],
f:[n('sbp','Pressão sistólica',60,260,'mmHg'),n('dbp','Pressão diastólica',30,160,'mmHg')],
r(v){const a=v.sbp,b=v.dbp;
const st=a>=180||b>=110?['HAS estágio 3',2]:a>=160||b>=100?['HAS estágio 2',2]:a>=140||b>=90?['HAS estágio 1',2]:a>=130||b>=85?['Pré-hipertensão',1]:a>=120||b>=80?['Pressão normal',0]:['Pressão ótima',0];
const iso=a>=140&&b<90;
return{big:a+'/'+b,lab:st[0]+(iso?' (sistólica isolada)':''),lv:st[1],
note:'Vale a categoria mais alta entre sistólica e diastólica. O diagnóstico de HAS exige medidas repetidas em consultas diferentes, ou confirmação com MAPA/MRPA. Cortes da Diretriz Brasileira de Hipertensão Arterial 2020.'}}},
{t:'Diabetes (FINDRISC)',h:'FINDRISC: risco de diabetes tipo 2 em 10 anos',d:'Questionário de rastreio sem exames de sangue, validado para adultos.',
z:['Baixo (&lt; 12 pts)','Moderado (12–14)','Alto (≥ 15)'],
f:[n('age','Idade',18,100,'anos'),s('sex','Sexo',SEX),n('peso','Peso',30,250,'kg'),n('alt','Altura',120,220,'cm'),n('cin','Circunferência abdominal',50,200,'cm'),
c('act','Atividade física de 30 min ou mais na maioria dos dias'),c('veg','Come frutas, verduras ou legumes todos os dias'),c('med','Usa ou já usou anti-hipertensivo'),c('glu','Já teve glicemia alta (exame, gestação ou doença)'),
s('fam','Familiar com diabetes',[['0','Nenhum'],['3','Parente de 2º grau (avós, tios, primos)'],['5','Parente de 1º grau (pais, irmãos, filhos)']])],
r(v){const a=v.age,b=v.peso/Math.pow(v.alt/100,2),m=v.sex=='M',w=v.cin;
const p=(a<45?0:a<55?2:a<65?3:4)+(b<25?0:b<=30?1:3)+(m?(w<94?0:w<=102?3:4):(w<80?0:w<=88?3:4))+(v.act?0:2)+(v.veg?0:1)+(v.med?2:0)+(v.glu?5:0)+(+v.fam);
const q=p<7?['1%','baixo']:p<12?['4%','levemente elevado']:p<15?['17%','moderado']:p<21?['33%','alto']:['50%','muito alto'];
return{big:p+' pts',lab:'Risco '+q[1],lv:p<12?0:p<15?1:2,
note:`Risco estimado de diabetes em 10 anos: cerca de ${q[0]}. IMC calculado: ${f1(b)} kg/m². Escores a partir de 15 justificam rastreio laboratorial (glicemia de jejum, HbA1c).`}}},
{t:'FA e AVC (CHA₂DS₂-VASc)',h:'CHA₂DS₂-VASc: risco de AVC na fibrilação atrial',d:'Apoia a decisão de anticoagulação em fibrilação atrial não valvar.',
z:['Baixo','Considerar ACO','ACO indicada'],
f:[s('age','Idade',[['0','Menos de 65 anos'],['1','65 a 74 anos'],['2','75 anos ou mais']]),s('sex','Sexo',SEX),c('chf','Insuficiência cardíaca ou disfunção de VE'),c('htn','Hipertensão arterial'),c('dm','Diabetes'),c('avc','AVC, AIT ou tromboembolismo prévio (2 pts)'),c('vasc','Doença vascular (IAM prévio, DAP ou placa aórtica)')],
r(v){const f=v.sex=='F'?1:0,p=+v.age+f+v.chf+v.htn+v.dm+2*v.avc+v.vasc,ns=p-f,lv=ns==0?0:ns==1?1:2;
return{big:p+' pts',lab:['Risco baixo: sem anticoagulação de rotina','Considerar anticoagulação oral','Anticoagulação oral indicada'][lv],lv,
note:'Interpretação conforme ESC 2020, que desconta o ponto do sexo feminino. Avalie sempre o risco de sangramento (HAS-BLED) antes de decidir.'}}},
{t:'IC com FEp (H₂FPEF)',h:'H₂FPEF: probabilidade de IC com fração de ejeção preservada',d:'Para paciente com dispneia e FEVE normal: ajuda a decidir se a IC com FEp é provável.',
z:['Baixa (0–1)','Intermediária (2–5)','Alta (≥ 6)'],
f:[c('obs','Obesidade: IMC &gt; 30 kg/m² (2 pts)'),c('htn','Usa 2 ou mais anti-hipertensivos'),c('fa','Fibrilação atrial (3 pts)'),c('hp','Hipertensão pulmonar: PSAP &gt; 35 mmHg no eco'),c('ida','Idade &gt; 60 anos'),c('fil','Pressão de enchimento: E/e\u2019 &gt; 9 no eco')],
r(v){const p=2*v.obs+v.htn+3*v.fa+v.hp+v.ida+v.fil,lv=p<2?0:p<6?1:2;
return{big:p+' pts',lab:['Baixa probabilidade de IC com FEp','Probabilidade intermediária de IC com FEp','Alta probabilidade de IC com FEp (&gt; 90%)'][lv],lv,
note:'Em escore intermediário, considere teste de esforço com hemodinâmica, ou cateterismo direito, para confirmar. Não substitui BNP/NT-proBNP e a avaliação ecocardiográfica completa.'}}},
{t:'Sangramento (HAS-BLED)',h:'HAS-BLED: risco de sangramento com anticoagulante',d:'Estima o risco de sangramento maior em pacientes com fibrilação atrial que usam ou vão usar anticoagulante.',
z:['Baixo (0–1)','Moderado (2)','Alto (≥ 3)'],
f:[c('h','Hipertensão não controlada (sistólica &gt; 160 mmHg)'),c('r','Disfunção renal (diálise, transplante ou creatinina &gt; 2,26 mg/dL)'),c('l','Disfunção hepática (cirrose ou bilirrubina &gt; 2x e TGO/TGP &gt; 3x o limite)'),c('s','AVC prévio'),c('b','Sangramento prévio ou predisposição (anemia, plaquetopenia)'),c('i','INR instável (menos de 60% do tempo na faixa)'),c('e','Idade &gt; 65 anos'),c('da','Uso de antiagregante ou AINE'),c('al','Álcool: 8 ou mais doses por semana')],
r(v){const p=+v.h+v.r+v.l+v.s+v.b+v.i+v.e+v.da+v.al,lv=p<2?0:p==2?1:2;
return{big:p+' pts',lab:['Risco baixo de sangramento','Risco moderado de sangramento','Risco alto de sangramento'][lv],lv,
note:'Escore ≥ 3 pede cuidado e revisão frequente, mas não contraindica a anticoagulação: o objetivo é corrigir os fatores modificáveis (pressão, INR, AINE, álcool).'}}},
{t:'Síndrome metabólica',h:'Síndrome metabólica (NCEP ATP III)',d:'Diagnóstico com 3 ou mais dos 5 critérios. Uso de medicamento para o fator conta como critério presente.',
z:['Sem síndrome (0–2)','Síndrome metabólica (3)','Síndrome metabólica (4–5)'],
f:[s('sex','Sexo',SEX),n('cin','Circunferência abdominal',50,200,'cm'),n('tg','Triglicerídeos',30,1000,'mg/dL'),n('hdl','HDL-colesterol',15,120,'mg/dL'),n('sbp','Pressão sistólica',70,250,'mmHg'),n('dbp','Pressão diastólica',40,150,'mmHg'),n('gli','Glicemia de jejum',40,500,'mg/dL'),c('pa','Usa anti-hipertensivo'),c('gl','Usa medicamento para glicemia (diabetes)'),c('lip','Usa fibrato ou niacina')],
r(v){const m=v.sex=='M',k=+(v.cin>(m?102:88))+(v.tg>=150||v.lip)+(v.hdl<(m?40:50)||v.lip)+(v.sbp>=130||v.dbp>=85||v.pa)+(v.gli>=100||v.gl),lv=k<3?0:k==3?1:2;
return{big:k+' de 5',lab:k>=3?'Síndrome metabólica presente':'Critérios insuficientes para síndrome metabólica',lv,
note:`Cortes usados: cintura &gt; ${m?102:88} cm, TG ≥ 150, HDL &lt; ${m?40:50}, pressão ≥ 130/85, glicemia ≥ 100 mg/dL. A síndrome metabólica indica risco aumentado de diabetes e de doença cardiovascular.`}}},
{t:'Critérios IC (Framingham)',h:'Critérios de Framingham para insuficiência cardíaca',d:'Diagnóstico clínico de IC: 2 critérios maiores, ou 1 maior e 2 menores.',
z:['Insuficiente','Suspeita','IC diagnosticada'],
f:[c('M1','Maior: dispneia paroxística noturna ou ortopneia'),c('M2','Maior: turgência jugular'),c('M3','Maior: estertores pulmonares'),c('M4','Maior: cardiomegalia'),c('M5','Maior: edema agudo de pulmão'),c('M6','Maior: terceira bulha (B3)'),c('M7','Maior: pressão venosa central &gt; 16 cmH₂O'),c('M8','Maior: refluxo hepatojugular'),
c('m1','Menor: edema de membros inferiores'),c('m2','Menor: tosse noturna'),c('m3','Menor: dispneia aos esforços'),c('m4','Menor: hepatomegalia'),c('m5','Menor: derrame pleural'),c('m6','Menor: capacidade vital reduzida a 1/3 do máximo'),c('m7','Menor: taquicardia (FC &gt; 120 bpm)'),c('wl','Perda de 4,5 kg ou mais em 5 dias com tratamento (conta como maior ou menor)')],
r(v){let M=0,m=0;for(const k in v){if(k[0]=='M'&&v[k])M++;if(k[0]=='m'&&v[k])m++}
const dx=(a,b)=>a>=2||(a>=1&&b>=2),ok=dx(M,m)||(v.wl&&(dx(M+1,m)||dx(M,m+1))),lv=ok?2:(M>=1||m>=2||v.wl)?1:0;
return{big:M+' maiores, '+m+' menores',lab:['Critérios insuficientes para IC','Suspeita: critérios incompletos','Critérios de IC preenchidos'][lv],lv,
note:'Os critérios são clínicos e têm boa especificidade, mas pouca sensibilidade. Confirme com BNP/NT-proBNP e ecocardiograma antes de fechar o diagnóstico.'}}},
{t:'SCA (TIMI)',h:'TIMI: risco na angina instável e IAM sem supra de ST',d:'Risco de morte, IAM ou revascularização urgente em 14 dias.',
z:['Baixo (0–2)','Intermediário (3–4)','Alto (5–7)'],
f:[c('a','Idade de 65 anos ou mais'),c('fr','3 ou mais fatores de risco para DAC (HAS, DM, dislipidemia, tabagismo, história familiar)'),c('est','Estenose coronariana conhecida de 50% ou mais'),c('aas','Uso de AAS nos últimos 7 dias'),c('ang','Angina grave: 2 ou mais episódios em 24 h'),c('st','Desvio de ST de 0,5 mm ou mais'),c('mar','Marcador de necrose miocárdica elevado')],
r(v){const p=+v.a+v.fr+v.est+v.aas+v.ang+v.st+v.mar,pr=['4,7%','4,7%','8,3%','13,2%','19,9%','26,2%','40,9%','40,9%'][p],lv=p<3?0:p<5?1:2;
return{big:p+' pts',lab:['Risco baixo','Risco intermediário','Risco alto'][lv],lv,
note:`Eventos em 14 dias no estudo original: cerca de ${pr}. Escores altos favorecem estratégia invasiva precoce. Use junto com ECG seriado, troponina e o quadro clínico.`}}},
{t:'TEP (Wells)',h:'Escore de Wells para embolia pulmonar',d:'Probabilidade pré-teste de TEP, para decidir entre D-dímero e angiotomografia.',
z:['Baixa (&lt; 2)','Moderada (2–6)','Alta (&gt; 6)'],
f:[c('tvp','Sinais clínicos de TVP (3 pts)'),c('alt','TEP é o diagnóstico mais provável (3 pts)'),c('fc','Frequência cardíaca &gt; 100 bpm (1,5 pt)'),c('imo','Imobilização ou cirurgia nas últimas 4 semanas (1,5 pt)'),c('prev','TVP ou TEP prévios (1,5 pt)'),c('hem','Hemoptise (1 pt)'),c('ca','Câncer ativo ou tratado nos últimos 6 meses (1 pt)')],
r(v){const p=3*v.tvp+3*v.alt+1.5*(v.fc+v.imo+v.prev)+v.hem+v.ca,lv=p<2?0:p<=6?1:2;
return{big:f1(p)+' pts',lab:['Probabilidade baixa de TEP','Probabilidade moderada de TEP','Probabilidade alta de TEP'][lv],lv,
note:`Pela versão de duas categorias, ${p>4?'TEP é provável (&gt; 4): indicar angiotomografia de tórax':'TEP é improvável (≤ 4): D-dímero pode excluir o diagnóstico'}. Em instabilidade hemodinâmica, siga o fluxo de TEP de alto risco.`}}},
{t:'Classe funcional (NYHA)',h:'Classificação funcional da NYHA na insuficiência cardíaca',d:'Classifica a limitação do paciente pelos sintomas (dispneia, fadiga, palpitações). Escolha a descrição que melhor corresponde.',
z:['Classe I ou II','Classe III','Classe IV'],
f:[s('cl','Sintomas e limitação',[['1','Classe I: sem limitação; a atividade habitual não causa sintomas'],['2','Classe II: limitação leve; confortável em repouso, mas a atividade habitual causa sintomas'],['3','Classe III: limitação acentuada; confortável em repouso, mas esforços menores que os habituais causam sintomas'],['4','Classe IV: sintomas aos mínimos esforços ou em repouso; incapaz de qualquer atividade sem desconforto']])],
r(v){const i=+v.cl;
return{big:'NYHA '+['I','II','III','IV'][i-1],lab:['Sem limitação funcional','Limitação funcional leve','Limitação funcional acentuada','Sintomas em repouso ou aos mínimos esforços'][i-1],lv:i<3?0:i-2,
note:'A classe NYHA descreve os sintomas atuais e pode mudar com o tratamento, ao contrário do estágio ACC/AHA (A a D), que só progride. Use os dois juntos para descrever o paciente com IC.'}}}
];
const G=[['Risco global',[0,6]],['Hipertensão',[1]],['Diabetes',[2]],['Insuficiência cardíaca',[10,4,7]],['Fibrilação atrial',[3,5]],['Emergências',[8,9]]];
let cur=0;const Gn=document.getElementById('G'),T=document.getElementById('T'),F=document.getElementById('F'),R=document.getElementById('R');
function tabs(){const gi=G.findIndex(g=>g[1].includes(cur)),ids=G[gi][1];
Gn.innerHTML=G.map((g,i)=>`<button data-g="${i}" class="${i==gi?'on':''}">${g[0]}</button>`).join('');
T.hidden=ids.length<2;
T.innerHTML=ids.map(i=>`<button data-i="${i}" class="${i==cur?'on':''}">${C[i].t}</button>`).join('')}
Gn.addEventListener('click',e=>{const b=e.target.closest('button');if(b){cur=G[+b.dataset.g][1][0];tabs();form()}});
function form(){const x=C[cur];
F.innerHTML=`<h2>${x.h}</h2><p class="d">${x.d}</p><div class="g">`+x.f.map(f=>f.k=='n'?`<label>${f.l}${f.u?' ('+f.u.trim()+')':''}<input type="number" inputmode="decimal" id="${f.id}" placeholder="${f.min} a ${f.max}"></label>`:f.k=='s'?`<label>${f.l}<select id="${f.id}">${f.o.map(o=>`<option value="${o[0]}">${o[1]}</option>`).join('')}</select></label>`:`<label class="ck"><input type="checkbox" id="${f.id}">${f.l}</label>`).join('')+'</div>';
calc()}
function calc(){const x=C[cur],v={};let ok=true,w='';
x.f.forEach(f=>{const e=document.getElementById(f.id);
if(f.k=='n'){const a=parseFloat(e.value);v[f.id]=a;if(isNaN(a))ok=false;else if(a<f.min||a>f.max)w=`Atenção: ${f.l.toLowerCase()} fora do intervalo esperado (${f.min} a ${f.max}). Confira o valor.`}
else v[f.id]=f.k=='c'?e.checked:e.value});
